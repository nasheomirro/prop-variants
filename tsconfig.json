{
  "compilerOptions": {
    "emitDeclarationOnly": true,
    "target": "ES2015",
    "outDir": "dist",
    "moduleResolution": "node",
    "lib": ["ES2015"],
    "declaration": true,
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
