{
  "name": "prop-variants",
  "version": "0.2.0",
  "description": "",
  "scripts": {
    "build": "pnpm test && pnpm build:cjs && pnpm build:esm",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    "import": "./dist/esm/index.js",
    "require": "./dist/cjs/index.js"
  },
  "keywords": [
    "variants",
    "props",
    "classes",
    "map"
  ],
  "files": [
    "dist/"
  ],
  "author": "nasheomirro",
  "license": "MIT",
  "homepage": "https://github.com/nasheomirro/prop-variants#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/nasheomirro/prop-variants.git"
  },
  "bugs": {
    "url": "https://github.com/nasheomirro/prop-variants/issues"
  },
  "packageManager": "pnpm@10.8.1",
  "devDependencies": {
    "@changesets/cli": "^2.29.2",
    "typescript": "^5.8.3"
  }
}
